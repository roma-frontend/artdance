# ═══════════════════════════════════════════════════════════════════
# ArtDance — переменные окружения.
#
# Схема и валидация: src/config/env.ts. Приложение НЕ ЗАПУСТИТСЯ, если
# обязательная переменная отсутствует или имеет неверный формат — это
# сознательное решение: лучше упасть при деплое, чем на платеже клиента.
#
# Скопируйте в .env.local и заполните. .env* в git не попадают.
# ═══════════════════════════════════════════════════════════════════

# ─── Приложение (публичные, попадают в клиентский бандл) ───
NEXT_PUBLIC_APP_URL=http://localhost:3000
# local | preview | staging | production
NEXT_PUBLIC_APP_ENV=local
# hy | ru | en
NEXT_PUBLIC_DEFAULT_LOCALE=hy

# ─── Feature flags (true|false) ───
# Позволяют сдавать платформу фазами, не удаляя код незавершённых модулей.
NEXT_PUBLIC_FEATURE_SHOP=true
NEXT_PUBLIC_FEATURE_COURSES=false
NEXT_PUBLIC_FEATURE_EVENTS=true
NEXT_PUBLIC_FEATURE_SUBSCRIPTIONS=true
NEXT_PUBLIC_FEATURE_VIDEO=false

# ─── База данных (Supabase / PostgreSQL) ───
# DATABASE_URL — через pooler (для приложения)
# DIRECT_DATABASE_URL — прямое подключение (для миграций)
#
# У Supabase «прямое подключение» (db.<ref>.supabase.co) имеет только IPv6-адрес,
# а IPv4 — платная опция, поэтому на большинстве машин и в CI оно недоступно.
# Рабочая пара — оба подключения через Supavisor, на одном хосте, разными портами:
#   DATABASE_URL        → порт 6543, transaction mode (приложение, serverless)
#   DIRECT_DATABASE_URL → порт 5432, session mode (миграции: Migrate берёт
#                         advisory locks, которых в transaction mode нет)
#
# Два обязательных штриха в строке:
#   • пароль percent-кодируется (`@` → %40, `$` → %24) — иначе парсер URL
#     обрывает строку на первом символе `@` внутри пароля;
#   • `uselibpqcompat=true` рядом с `sslmode=require` — Supavisor предъявляет
#     самоподписанный сертификат в цепочке, и node-postgres без этого флага
#     требует полной проверки CA и рвёт соединение («self-signed certificate in
#     certificate chain»). Флаг возвращает семантику libpq: канал шифруется,
#     цепочка не проверяется — так же ведёт себя psql.
#
# postgresql://postgres.<ref>:<пароль>@aws-0-<регион>.pooler.supabase.com:6543/postgres?sslmode=require&uselibpqcompat=true
DATABASE_URL=postgresql://postgres:password@localhost:5432/artdance
DIRECT_DATABASE_URL=postgresql://postgres:password@localhost:5432/artdance

# ─── Аутентификация ───
# Сгенерировать: openssl rand -base64 48
AUTH_SECRET=
AUTH_TRUSTED_ORIGINS=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Платежи ───
# paynet | arca-epg | ameria-vpos | idram | mock
# `mock` позволяет разрабатывать и тестировать checkout до подписания
# договора с банком-эквайрером.
PAYMENT_PROVIDER=mock
PAYMENT_RETURN_PATH=/checkout/result

# Paynet (единый API: ARCA / Idram / Telcell / ArcaQR)
PAYNET_API_URL=
PAYNET_MERCHANT_ID=
PAYNET_API_KEY=
PAYNET_WEBHOOK_SECRET=

# ArCa EPG (ACBA / Ardshinbank / Inecobank и другие банки-партнёры arca.am)
ARCA_EPG_API_URL=
ARCA_EPG_USERNAME=
ARCA_EPG_PASSWORD=

# Ameriabank VPOS
AMERIA_VPOS_API_URL=
AMERIA_VPOS_CLIENT_ID=
AMERIA_VPOS_USERNAME=
AMERIA_VPOS_PASSWORD=

# Idram (напрямую)
IDRAM_MERCHANT_ID=
IDRAM_SECRET_KEY=

# ─── Медиа (Cloudflare R2) ───
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=artdance-media
R2_PUBLIC_BASE_URL=
NEXT_PUBLIC_MEDIA_CDN_URL=

# ─── Email (Resend) ───
RESEND_API_KEY=
EMAIL_FROM=noreply@artdance.am
EMAIL_REPLY_TO=support@artdance.am

# ─── SMS ───
# twilio | local-aggregator | mock
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_API_SECRET=
# Alphanumeric sender ID требует регистрации (~2–3 недели)
SMS_SENDER_ID=ArtDance

# ─── Безопасность ───
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Upstash Redis REST — распределённый rate limiting.
# ВАЖНО: в production при отсутствии этих переменных чувствительные операции
# (логин, платежи, брони) отклоняются — fail closed. Локально работает
# in-memory-фолбэк, поэтому переменные не обязательны для разработки.
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_REDIS_TOKEN=
# Защита cron-эндпоинтов от внешних вызовов
CRON_SECRET=

# ─── Наблюдаемость ───
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
# Доля трассируемых запросов: 1 на старте, 0.05–0.1 при росте трафика
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
# Session replay содержит PII и стоит денег — включать осознанно
NEXT_PUBLIC_SENTRY_REPLAY_ON_ERROR=0
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ─── Карты ───
NEXT_PUBLIC_MAPS_API_KEY=
MAPS_SERVER_API_KEY=

# ─── Прочее ───
# Источник курса валют для отображения цен в USD/EUR (конвертация визуальная)
EXCHANGE_RATE_API_URL=


# ─── Корзина ───
# Окончательное удаление содержимого корзины идёт по расписанию:
#   POST /api/cron/purge-trash  с заголовком `Authorization: Bearer $CRON_SECRET`
# Расписание объявлено в `vercel.json`, срок хранения — в `src/config/trash.ts`.
# Без CRON_SECRET эндпоинт отвечает 503 и ничего не удаляет: открытый эндпоинт
# чистки означает, что стереть контент платформы может любой, кто знает адрес.
