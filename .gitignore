# Uploads живут только на R2 + DB (MediaAsset.storageKey), не в git.
# Все медиа живут в R2 (`design/media-r2-manifest.json`), в git их нет.
# `public/media` — рабочая папка для design:import и media:optimize; после
# media:r2:sync её можно удалить. Проверки сверяются с манифестом, не с диском.
/public/media/
# brand logos живут в R2 (`brand/logo*.png`), а не в `public/` — см. src/components/brand/brand-mark.tsx

