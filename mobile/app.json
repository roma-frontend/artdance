{
  "expo": {
    "name": "ArtDance",
    "slug": "artdance",
    "scheme": "artdance",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0809",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0809"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "am.artdance.app",
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:artdance.am"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "am.artdance.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "https",
              "host": "artdance.am",
              "pathPrefix": "/reset-password"
            },
            {
              "scheme": "https",
              "host": "artdance.am",
              "pathPrefix": "/verify-email"
            },
            {
              "scheme": "https",
              "host": "artdance.am",
              "pathPrefix": "/newsletter"
            }
          ]
        }
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#8B1A2B"
      },
      "permissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow $(PRODUCT_NAME) to unlock the support dashboard with Face ID."
        }
      ],
      "expo-font",
      "expo-image",
      "expo-calendar",
      "expo-notifications",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "ArtDance использует камеру, чтобы сканировать QR-пропуск клиента на входе.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ArtDance использует фото из галереи, чтобы вы могли выбрать аватар.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      "expo-apple-authentication",
      "./plugins/with-release-signing",
      "expo-video",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Нужен микрофон, чтобы продиктовать сообщение ассистенту.",
          "speechRecognitionPermission": "Распознавание речи нужно, чтобы превращать голос в текст для ассистента."
        }
      ],
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.am.artdance.app",
          "widgets": [
            {
              "name": "NextClassWidget",
              "displayName": "ArtDance: next class",
              "description": "Time and title of your next booked class.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ],
                "initialLayout": "widgets/NextClassWidget.tsx"
              },
              "android": null
            }
          ]
        }
      ],
      ["@stripe/stripe-react-native", {}]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "a8d79712-99f0-4b8f-8fb5-2a3edd29c009"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a8d79712-99f0-4b8f-8fb5-2a3edd29c009"
    }
  }
}
