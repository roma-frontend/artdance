# Пакеты Remotion: ставятся `npm install`, в репозитории не нужны
node_modules/

# Рабочие файлы рендера: черновики, листы кадров, скачанные треки, wav.
# Весят сотни мегабайт и воспроизводятся одной командой из README.
work/

# Копии ассетов проекта (34 МБ). Источники лежат в `.open-next/assets/media`,
# который сам в .gitignore. Держать рядом вторую копию смысла нет: она
# разъедется с проектом при первом обновлении медиа. Восстанавливается
# командой `node scripts/copy-assets.mjs`.
public/assets/
