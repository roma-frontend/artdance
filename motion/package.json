{
  "name": "artdance-motion",
  "version": "1.0.0",
  "description": "Презентационный ролик ArtDance: Remotion, три языка",
  "private": true,
  "scripts": {
    "assets": "node scripts/copy-assets.mjs",
    "studio": "remotion studio src/index.ts",
    "draft": "remotion render src/index.ts ArtDance-ru work/draft.mp4 --scale=0.35 --concurrency=3 --crf=28",
    "render": "remotion render src/index.ts ArtDance-ru out-ru.mp4 --concurrency=3 --crf=17"
  },
  "license": "UNLICENSED",
  "type": "commonjs",
  "dependencies": {
    "@remotion/cli": "^4.0.537",
    "@remotion/google-fonts": "^4.0.537",
    "@remotion/media-utils": "^4.0.537",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.537",
    "typescript": "^7.0.2"
  }
}
