{
  "name": "artdance",
  "version": "0.1.0",
  "private": true,
  "description": "ArtDance — dance marketplace & booking platform (Armenia)",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@11.13.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "tokens:build": "tsx scripts/build-tokens.ts",
    "tokens:check": "tsx scripts/build-tokens.ts --check",
    "i18n:check": "tsx scripts/check-i18n.ts",
    "design:import": "tsx scripts/import-design-assets.ts",
    "design:status": "tsx scripts/design-status.ts",
    "media:optimize": "tsx scripts/optimize-media.ts",
    "media:check": "tsx scripts/optimize-media.ts --check",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest --run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "e2e:report": "playwright show-report",
    "verify": "npm run tokens:check && npm run i18n:check && npm run media:check && npm run typecheck && npm run lint && npm run test",
    "verify:quick": "npm run typecheck && npm run lint",
    "verify:headers": "node scripts/verify-headers.mjs",
    "perf:budget": "tsx scripts/check-performance-budget.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@date-fns/tz": "1.5.0",
    "@hookform/resolvers": "5.9.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "@sentry/nextjs": "^10.73.0",
    "@tanstack/react-query": "5.102.8",
    "better-auth": "1.7.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "input-otp": "1.5.0",
    "lucide-react": "1.38.0",
    "next": "16.3.4",
    "next-intl": "4.14.1",
    "next-safe-action": "8.6.1",
    "next-themes": "0.4.6",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-day-picker": "10.0.1",
    "react-dom": "19.2.8",
    "react-hook-form": "7.87.0",
    "resend": "6.25.0",
    "server-only": "^0.0.1",
    "sharp": "0.35.4",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "1.1.2",
    "zod": "4.5.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "dotenv": "^17.4.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "3.2.7"
  }
}
