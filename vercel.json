{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["hnd1"],
  "rewrites": [
    {
      "source": "/media-proxy/:path*",
      "destination": "https://${R2_PUBLIC_URL}/:path*"
    }
  ],
  "headers": [
    {
      "source": "/media-proxy/:path*",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/purge-holds",
      "schedule": "37 3 * * *"
    },
    {
      "path": "/api/cron/purge-trash",
      "schedule": "17 3 * * *"
    },
    {
      "path": "/api/cron/support-sla",
      "schedule": "17 7 * * *"
    }
  ]
}
